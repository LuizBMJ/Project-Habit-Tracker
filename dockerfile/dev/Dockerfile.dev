FROM php:8.4-cli

# Instalar dependências do sistema
RUN apt-get update && apt-get install -y \
    git unzip curl libpq-dev libzip-dev zip libonig-dev \
    libpng-dev libjpeg-dev libfreetype6-dev \
    && docker-php-ext-install \
    pdo \
    pdo_pgsql \
    pgsql \
    mbstring \
    zip \
    bcmath \
    gd

# Instalar Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Instalar wait-for-it para aguardar o banco de dados
RUN curl -fsSL https://raw.githubusercontent.com/vishnubob/wait-for-it/master/wait-for-it.sh -o /usr/local/bin/wait-for-it.sh \
    && chmod +x /usr/local/bin/wait-for-it.sh

# Diretório da aplicação
WORKDIR /app

# Copiar apenas arquivos de dependências primeiro (para cache de camadas)
COPY composer.json composer.lock package.json package-lock.json ./

# Instalar dependências PHP (com dev)
RUN composer install --no-interaction --no-scripts

# Instalar dependências Node (com dev)
RUN npm install

# Copiar o restante do projeto
COPY . .

# Criar diretórios necessários
RUN mkdir -p storage/framework/{cache,sessions,views} storage/logs bootstrap/cache

# Permissões Laravel
RUN chmod -R 777 storage bootstrap/cache

# Script de inicialização
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 10000 5173

ENTRYPOINT ["docker-entrypoint.sh"]

